    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <EventSourceSupport>true</EventSourceSupport>
    <EnableAotAnalyzer Condition="'$(GdkNetEnableAotAnalyzers)' != 'false'">true</EnableAotAnalyzer>
