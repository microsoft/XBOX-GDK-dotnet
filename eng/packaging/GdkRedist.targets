<Project>
  <PropertyGroup>
    <!-- Repository applications and packaged consumers use the same resolver, never installed
         environment variables or upstream build-only imports. -->
    <_GdkNetPackageEdition Condition="'$(_GdkNetPackageEdition)' == ''">$(GdkEdition)</_GdkNetPackageEdition>
    <_GdkNetPackageWindowsVersion Condition="'$(_GdkNetPackageWindowsVersion)' == ''">$(GdkWindowsVersion)</_GdkNetPackageWindowsVersion>
    <_GdkNetPackageCoreVersion Condition="'$(_GdkNetPackageCoreVersion)' == ''">$(GdkCoreVersion)</_GdkNetPackageCoreVersion>
    <GdkRedistArchitecture Condition="'$(GdkRedistArchitecture)' == '' and '$(RuntimeIdentifier)' == 'win-arm64'">arm64</GdkRedistArchitecture>
    <GdkRedistArchitecture Condition="'$(GdkRedistArchitecture)' == '' and '$(Platform)' == 'ARM64'">arm64</GdkRedistArchitecture>
    <GdkRedistArchitecture Condition="'$(GdkRedistArchitecture)' == ''">x64</GdkRedistArchitecture>
    <GdkNetIncludeXboxLive Condition="'$(GdkNetIncludeXboxLive)' == ''">false</GdkNetIncludeXboxLive>
    <GdkNetIncludePlayFabMultiplayer Condition="'$(GdkNetIncludePlayFabMultiplayer)' == ''">false</GdkNetIncludePlayFabMultiplayer>
    <GdkNetIncludePlayFabParty Condition="'$(GdkNetIncludePlayFabParty)' == ''">false</GdkNetIncludePlayFabParty>
    <GdkNetIncludePlayFab Condition="'$(GdkNetIncludePlayFab)' == ''">false</GdkNetIncludePlayFab>
  </PropertyGroup>

  <UsingTask TaskName="GdkNetResolveNativeAssets" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <Task>
      <Code Type="Class" Language="cs" Source="$(MSBuildThisFileDirectory)GdkNet.ResolveNativeAssets.cs" />
    </Task>
  </UsingTask>

  <Target Name="GdkNetResolveRedistributables"
          BeforeTargets="AssignTargetPaths"
          DependsOnTargets="ResolvePackageAssets"
          Condition="'$(TargetFramework)' != '' and '$(DesignTimeBuild)' != 'true'">
    <GdkNetResolveNativeAssets AssetsFile="$(ProjectAssetsFile)"
                              SdkToolsPath="$(MSBuildToolsPath)"
                              Edition="$(_GdkNetPackageEdition)"
                              WindowsVersion="$(_GdkNetPackageWindowsVersion)"
                              CoreVersion="$(_GdkNetPackageCoreVersion)"
                              Architecture="$(GdkRedistArchitecture)"
                              RuntimeIdentifier="$(RuntimeIdentifier)"
                              IncludeXboxLive="$(GdkNetIncludeXboxLive)"
                              IncludePlayFab="$(GdkNetIncludePlayFab)"
                              IncludePlayFabMultiplayer="$(GdkNetIncludePlayFabMultiplayer)"
                              IncludePlayFabParty="$(GdkNetIncludePlayFabParty)">
      <Output TaskParameter="NativeAssets" ItemName="_GdkNetNativeAsset" />
      <Output TaskParameter="WindowsRoot" PropertyName="GdkNetResolvedWindowsRoot" />
      <Output TaskParameter="CoreRoot" PropertyName="GdkNetResolvedCoreRoot" />
    </GdkNetResolveNativeAssets>
    <ItemGroup>
      <None Include="@(_GdkNetNativeAsset)" Link="%(Filename)%(Extension)"
            CopyToOutputDirectory="Always" CopyToPublishDirectory="Always"
            Visible="false" Pack="false" />
    </ItemGroup>
  </Target>
</Project>
